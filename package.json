{
  "name": "build-your-own-react",
  "version": "1.0.0",
  "description": "button.jsx --> html + js\r     button.css --> css\r     app.jsx --> html + js\r     index.css -> --> css\r     main.jsx  --> html + js\r     app.css --> --> css",
  "main": "./src/main.ts",
  "scripts": {
    "dev:ts": "esbuild src/main.ts --bundle --outfile=./dist/assets/main.js --format=esm --sourcemap --watch",
    "dev:typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "dev:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./dist/assets/output.css --watch",
    "dev:serve": "browser-sync start --server --single --files \"dist/**/*.js,dist/**/*.css,index.html\" --no-notify --port 3000",
    "dev": "concurrently \"npm run dev:ts\" \"npm run dev:typecheck\" \"npm run dev:css\" \" npm run dev:serve \" --names \"ESB,TSC,CSS,BS\" --prefix-colors \"cyan,blue,green,yellow\"",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --outfile=./dist/assets/main.js --format=esm --minify && npx @tailwindcss/cli -i ./src/css/input.css -o ./dist/assets/output.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarangkale66/kodr-5-BuildYourOwnReact.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Sarangkale66/kodr-5-BuildYourOwnReact/issues"
  },
  "homepage": "https://github.com/Sarangkale66/kodr-5-BuildYourOwnReact#readme",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
